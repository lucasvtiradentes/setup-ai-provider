{
	"name": "setup-ai-provider",
	"version": "0.0.0",
	"description": "GitHub Action for installing, authenticating, and collecting session files for AI provider CLIs",
	"packageManager": "pnpm@10.22.0",
	"main": "dist/index.js",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsup",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"check": "biome check src/ tests/",
		"check:fix": "biome check --fix src/ tests/",
		"knip": "knip",
		"release:github": "bash .github/scripts/release-github-action.sh",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/artifact": "^6.2.1",
		"@actions/core": "^1.11.1",
		"@actions/exec": "^1.1.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.29.7",
		"@types/node": "^22.10.2",
		"knip": "^5.71.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4"
	}
}
